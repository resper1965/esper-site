# ┌──────────────────────────────────────────────────────────────
# │  esper.ws — Environment Variables
# │  Copy to .env.local and fill in your values
# └──────────────────────────────────────────────────────────────

# ── Supabase (required) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── AI / LLM (at least one required for content generation) ──
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ── Cloudflare AI Gateway (optional) ─────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_GATEWAY_ID=esper-ai-gateway
AI_GATEWAY_API_KEY=
CLOUDFLARE_API_TOKEN=

# ── Cloudflare Vectorize (optional — semantic search) ────────
CLOUDFLARE_VECTORIZE_INDEX=esper-posts

# ── Image Generation (optional) ──────────────────────────────
REPLICATE_API_TOKEN=

# ── Email Notifications (optional) ───────────────────────────
EMAIL_NOTIFICATIONS=false
EMAIL_FROM=noreply@esper.ws
NOTIFICATION_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Auto-Generate Cron (optional) ────────────────────────────
CRON_SECRET=
AUTO_PUBLISH=false

# ── Analytics (optional) ─────────────────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=        # Cloudflare Web Analytics

# ── Cloudflare Turnstile CAPTCHA (recommended) ───────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
