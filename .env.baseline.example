# GSC_SA_PRIVATE_KEY é o campo `private_key` do JSON da chave da conta de
# serviço, colado numa linha só, com as quebras de linha escritas como \n
# literais. O valor inteiro precisa ir entre aspas.
# Conta de serviço do Google, com o e-mail dela adicionado como usuário da
# propriedade no Search Console. Names only — nunca um valor aqui.
GSC_SA_EMAIL=
GSC_SA_PRIVATE_KEY=
GSC_SITE_URL=sc-domain:ricardoesper.com.br

# Sonda de modelo. Só os provedores que você quiser medir precisam estar preenchidos.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
