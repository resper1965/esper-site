# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated
.source

# database
/data
*.db
*.db-shm
*.db-wal
/drizzle

# OpenNext Cloudflare build output
.open-next/

# Estado local do wrangler (bundles e assets temporários do `wrangler dev`)
.wrangler/
cloudflare-env.d.ts

# Marca da Web do Windows. São metadados de 25 bytes que o Explorer cria ao
# baixar um arquivo ("[ZoneTransfer] ZoneId=3"), e dois deles foram commitados
# em assets/ por acidente. Não servem para nada no repositório e tornavam o
# clone impossível no Windows: `:` é caractere ilegal em nome de arquivo no
# NTFS, e o git recusa a árvore inteira por causa deles.
*:Zone.Identifier
